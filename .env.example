# --- Deployment ---
# Framio serves from the domain root of its own GitHub Pages subdomain
# (framio.britx.me) by default — leave these unset locally and in most
# forks. See lib/basePath.ts and README.md's Deploy section.
#   PAGES_BASE_PATH=      # only for a sub-path deploy, e.g. /framio
#   NEXT_PUBLIC_SITE_URL= # absolute origin for canonical/OG URLs, default https://framio.britx.me

# --- The Met Collection API ---
# No key required. Override only for testing/mocking.
MET_API_BASE=https://collectionapi.metmuseum.org/public/collection/v1

# --- Image proxy (optional) ---
# Some museum image hosts (notably the Art Institute of Chicago's IIIF server)
# now sit behind Cloudflare bot protection and answer hotlinked <img> requests
# with a 403 challenge instead of the picture. Point this at a proxy you control
# (e.g. a free Cloudflare Worker) to route those images through it and make them
# load reliably. Leave it blank and Framio leans on the image-reliable sources
# (Met, Cleveland, SMK, Wikimedia) so the grid is never full of blank cards.
# Use a {url} placeholder for the encoded source, or omit it to append the URL:
#   NEXT_PUBLIC_IMAGE_PROXY=https://img.example.workers.dev/?url={url}
NEXT_PUBLIC_IMAGE_PROXY=

# --- Supabase ---
# Optional for MVP Browse (which runs against the live Met API with no config).
# Required once you save Favorites, build Collections, or upload your own images.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: cache upserts + Storage writes. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
