# --- The Met Collection API ---
# No key required. Override only for testing/mocking.
MET_API_BASE=https://collectionapi.metmuseum.org/public/collection/v1

# --- Supabase ---
# Optional for MVP Browse (which runs against the live Met API with no config).
# Required once you save Favorites, build Collections, or upload your own images.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: cache upserts + Storage writes. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
